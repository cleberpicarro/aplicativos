# Banco de dados PostgreSQL
DATABASE_URL=postgres://nerus:nerus@localhost:5432/nerus
# Endereço público do app (usado nos links dos e-mails)
APP_URL=http://localhost:5173
PORT=3000
# E-mail (Google Workspace). Sem SMTP_HOST, os e-mails são apenas escritos no log do servidor.
# Para testar localmente, deixe SMTP_HOST comentado.
# SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tarefas@suaempresa.com.br
SMTP_PASS=senha-de-app
MAIL_FROM=SyncTasks <tarefas@suaempresa.com.br>
